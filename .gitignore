# =====================================
# WiFiVision - Project-wide Git Ignore
# =====================================

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Frontend environment files
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local
frontend/.env.test.local

# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Frontend builds
.next/
out/
dist/
build/
coverage/

# Android / Gradle
.gradle/
**/build/
local.properties
keystore.properties
*.jks
*.keystore

# Windows Companion build outputs
windows/bin/
windows/obj/
*.pfx
*.snk

# IDE and editor files
.idea/
.vscode/
*.iml

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
tmp/
temp/
*.tmp

# Test and coverage output
.nyc_output/

# TypeScript incremental build info
*.tsbuildinfo

# Local frontend backup snapshots
frontend_backup_*/
