# =====================================
# WiFiVision Frontend Configuration
# =====================================

# Browser API base path:
# - Production (same-origin proxy on Vercel): /api
# - Local development (separate backend port): http://localhost:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Server-only backend origin used by Next.js /api/* rewrites (never exposed as NEXT_PUBLIC_)
# Example for Vercel: BACKEND_ORIGIN=https://your-wifivision-backend.vercel.app
BACKEND_ORIGIN=
