# =====================================
# WiFiVision Backend Configuration
# =====================================

# Server
PORT=5000
NODE_ENV=development

# Frontend CORS (comma-separated origins; set to your production HTTPS frontend origin in production)
CORS_ORIGIN=http://localhost:3000

# MongoDB Database
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/wifivision?retryWrites=true&w=majority

# Authentication (JWT — 32+ chars required in production)
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_EXPIRES_IN=24h

# Server-Side Privacy & Device Secrets (32+ chars required in production)
BSSID_HMAC_SECRET=replace_with_a_32_plus_char_bssid_hmac_secret
DEVICE_TOKEN_PEPPER=replace_with_a_32_plus_char_device_pepper_secret

# Distributed Rate Limiting (Upstash Redis REST — required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP Email Service (OTP Verification — required when NODE_ENV=production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Optional explicit TLS override (defaults to true when SMTP_PORT=465)
# SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password
